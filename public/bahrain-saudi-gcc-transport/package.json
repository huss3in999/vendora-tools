{
  "name": "bahrain-saudi-gcc-transport",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-transport-site.mjs",
    "sync:search": "node scripts/sync-search-discovery.mjs",
    "validate:central-config": "node scripts/validate-central-config.mjs",
    "validate:search": "node scripts/validate-search-discovery.mjs",
    "validate:indexnow": "node scripts/submit-indexnow.mjs",
    "preview:gcc": "node scripts/generate-gcc-private-preview.mjs",
    "capture:gcc-preview": "node scripts/capture-gcc-preview-contact-sheet.mjs",
    "validate:gcc": "node scripts/validate-gcc-architecture.mjs",
    "check:gcc-preview": "npm run preview:gcc && npm run validate:gcc",
    "publish:gcc-batch-1": "node scripts/generate-gcc-route-batch-1.mjs && node scripts/sync-transport-site.mjs",
    "validate:gcc-batch-1": "node scripts/validate-gcc-route-batch-1.mjs",
    "test:gcc-batch-1": "playwright test tests/gcc-route-batch-1.spec.js",
