    "test:node": "node tests/analytics-api.test.mjs && node --test tests/batch1-security.test.cjs",
    "test": "npm run test:node && playwright test",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0"
  }
