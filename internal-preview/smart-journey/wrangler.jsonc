{
  "name": "vendora-smart-journey-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "traces": { "enabled": true } },
  "vars": { "WEATHER_ENABLED": "true", "GOOGLE_MAPS_BILLING_APPROVED": "false", "GOOGLE_KEY_RESTRICTIONS_VERIFIED": "false", "GOOGLE_PROVIDER_QUOTAS_VERIFIED": "false", "GOOGLE_TRAFFIC_AWARE_APPROVED": "false", "TOMTOM_FLOW_APPROVED": "false", "TOMTOM_PRESENTATION_APPROVED": "false", "GOOGLE_ROUTE_COVERAGE_APPROVED": "false" }
}
